# The BETA build mode — used by `npm run build:beta` / `npm run electron:build:beta`.
#
# This file is committed on purpose: it holds no secret — it does the opposite,
# EMPTYING every service variable so a beta build ships local-only
# (BETA-BUILD-PLAN.md §3). Vite gives a mode file (.env.beta) higher priority
# than .env.local, so the dev machine's own Supabase/MinIO config can stay in
# .env.local untouched and still never reach a beta installer.
#
# Empty value → supabase.js exports null → every caller takes its local
# fallback path (seed Library, local search, café boards politely closed).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MINIO_ENDPOINT=
