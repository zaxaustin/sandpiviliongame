{
  "name": "sand-pavilion",
  "private": true,
  "version": "0.1.0-beta.3",
  "description": "The Sand Pavilion — a small walkable world for reading, planning, and working, with AI residents that run on your own machine. Local-first; nothing phones home.",
  "author": "The Sand Pavilion stewards",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/smoke.mjs",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "build:beta": "vite build --mode beta && node scripts/verify-beta-build.mjs",
    "electron:build:beta": "vite build --mode beta && node scripts/verify-beta-build.mjs && electron-builder",
    "verify:beta": "node scripts/verify-beta-build.mjs",
    "icon": "node scripts/make-icon.mjs",
    "verify:release": "node scripts/verify-release-docs.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.4.0",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.sandpavilion.app",
    "productName": "Sand Pavilion",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/schema.sql",
      "tools/migrations/*.sql"
    ],
    "asarUnpack": [
      "**/node_modules/@electric-sql/pglite/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": null,
      "artifactName": "Sand Pavilion ${version} ${arch}.${ext}"
    },
    "dmg": {
      "title": "Sand Pavilion ${version}"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "pg": "^8.22.0"
  }
}
