{
  "name": "sand-pavilion",
  "private": true,
  "version": "0.1.0-beta.2",
  "description": "The Sand Pavilion — a small walkable world for reading, planning, and working, with AI residents that run on your own machine. Local-first; nothing phones home.",
  "author": "The Sand Pavilion stewards",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/smoke.mjs",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "build:beta": "vite build --mode beta && node scripts/verify-beta-build.mjs",
    "electron:build:beta": "vite build --mode beta && node scripts/verify-beta-build.mjs && electron-builder",
    "verify:beta": "node scripts/verify-beta-build.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.1.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.sandpavilion.app",
    "productName": "Sand Pavilion",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
